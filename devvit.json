{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "wrdlink",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "wrdlink_dev"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_POST",
        "SUBMIT_COMMENT"
      ]
    },
    "redis": true
  },
  "scheduler": {
    "tasks": {
      "daily-wrdlink-puzzle": {
        "endpoint": "/internal/scheduler/daily-puzzle-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  }
}
